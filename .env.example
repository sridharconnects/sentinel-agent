# LLM_MODE: mock | openai | ollama   (default: mock — no keys needed)
LLM_MODE=mock

# OpenAI backend
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama backend (local server)
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# Guardrails
MAX_CRITIC_ROUNDS=3
RUN_TIMEOUT_SECONDS=120
MAX_INPUT_CHARS=2000
# Comma-separated illustrative blocklist applied to the final briefing
BLOCKLIST=password,ssn,api_key
